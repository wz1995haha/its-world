/* app.wxss — 全局纸感样式（颜色全部走主题变量，五个主题共用一套） */

page {
  background: #E9DFCE;
  font-family: -apple-system, "PingFang SC", "Noto Sans CJK SC", sans-serif;
  color: #3A322C;
}

.app {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 32rpx 60rpx;
  background:
    radial-gradient(1200rpx 600rpx at 50% -6%, var(--bg-glow, #FBF6EC) 0%, rgba(0, 0, 0, 0) 62%),
    radial-gradient(900rpx 500rpx at 90% 10%, var(--bg-2, #E2D5BF) 0%, rgba(0, 0, 0, 0) 70%),
    var(--bg, #E9DFCE);
  color: var(--ink, #3A322C);
}

/* ---------- 文字 ---------- */
.serif {
  font-family: "Songti SC", "Noto Serif CJK SC", "STSong", serif;
}
.h1 {
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink, #3A322C);
}
.h2 {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--ink, #3A322C);
}
.sub {
  font-size: 24rpx;
  color: var(--muted, #8C8074);
  line-height: 1.6;
}
.dim {
  color: var(--muted, #8C8074);
}
.accent {
  color: var(--accent, #C2613F);
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--paper-2, #FBF6EC);
  border: 1rpx solid var(--line, rgba(58, 50, 44, .12));
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 40rpx -34rpx rgba(var(--sh, 58, 50, 44), .8);
}

.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--muted, #8C8074);
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  background: var(--paper-3, #FFFDF8);
  color: var(--ink, #3A322C);
  border: 1rpx solid var(--line, rgba(58, 50, 44, .12));
}
.btn.primary {
  background: var(--ink, #3A322C);
  color: var(--paper, #F5EEE3);
  border-color: transparent;
}
.btn.ghost {
  background: transparent;
  color: var(--accent, #C2613F);
  border-color: rgba(var(--accent-rgb, 194, 97, 63), .4);
}
.btn[disabled] {
  opacity: .45;
}
.btn.sm {
  height: 64rpx;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.link {
  color: var(--accent, #C2613F);
  font-size: 26rpx;
}

/* ---------- 事件按钮 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  width: calc((100% - 48rpx) / 4);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 4rpx;
  border-radius: 22rpx;
  background: var(--paper-2, #FBF6EC);
  border: 1rpx solid var(--line-soft, rgba(58, 50, 44, .07));
  position: relative;
}
.chip .ci {
  font-size: 34rpx;
  line-height: 1.2;
}
.chip .ct {
  font-size: 22rpx;
  margin-top: 6rpx;
  color: var(--ink-soft, #5C5148);
}
.chip.mine {
  border-color: rgba(var(--accent-rgb, 194, 97, 63), .34);
}
.chip.editing {
  border-style: dashed;
  border-color: rgba(var(--accent-rgb, 194, 97, 63), .5);
}
.chip .cx {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 24rpx;
  background: var(--paper-3, #FFFDF8);
  color: var(--accent, #C2613F);
  border: 1rpx solid rgba(var(--accent-rgb, 194, 97, 63), .5);
}
.chip.mv {
  position: absolute;
  bottom: -10rpx;
  width: 30rpx;
  height: 30rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 20rpx;
  background: var(--paper-3, #FFFDF8);
  color: var(--muted, #8C8074);
  border: 1rpx solid var(--line, rgba(58, 50, 44, .12));
}
.chip .mv.l { left: 4rpx; }
.chip .mv.r { right: 4rpx; }

/* ---------- 事实行 ---------- */
.ev {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: var(--paper-3, #FFFDF8);
  border: 1rpx solid var(--line-soft, rgba(58, 50, 44, .07));
  margin-bottom: 12rpx;
}
.ev .n {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--muted, #8C8074);
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 40rpx 24rpx;
  border-radius: 22rpx;
  border: 1rpx dashed var(--line, rgba(58, 50, 44, .12));
  color: var(--muted, #8C8074);
  font-size: 24rpx;
  text-align: center;
  line-height: 1.7;
}

/* ---------- 输入 ---------- */
.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: var(--paper-3, #FFFDF8);
  border: 1rpx solid var(--line, rgba(58, 50, 44, .12));
  font-size: 28rpx;
}
.field input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink, #3A322C);
}

/* ---------- 底部弹层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(20, 16, 12, .42);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  background: var(--paper-2, #FBF6EC);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line, rgba(58, 50, 44, .12));
}
.sheet .sheet-title {
  font-size: 30rpx;
  margin-bottom: 20rpx;
  color: var(--ink, #3A322C);
}
.opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 6rpx;
  border-bottom: 1rpx solid var(--line-soft, rgba(58, 50, 44, .07));
  font-size: 28rpx;
}
.opt.on {
  color: var(--accent, #C2613F);
}
/* 建档页的头像行 */
.obav { display: flex; align-items: center; gap: 28rpx; margin: 8rpx 0 24rpx; }
.obav-btns { display: flex; flex-direction: column; gap: 14rpx; }
