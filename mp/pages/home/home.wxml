<!-- home.wxml — 该做什么 -->
<view class="app" style="{{themeStyle}}">

  <block wx:if="{{!hasPet}}">
    <view class="card" style="margin-top:80rpx;text-align:center">
      <view class="h1 serif" style="margin-bottom:16rpx">先建一只</view>
      <view class="sub" style="margin-bottom:32rpx">建好之后，疫苗、驱虫这些它会帮你记着日子。</view>
      <view class="btn primary" bindtap="start">去建档</view>
    </view>
  </block>

  <block wx:else>
    <!-- 宠物切换 -->
    <view class="petsw">
      <view
        class="ps {{item.on ? 'on' : ''}}"
        wx:for="{{pets}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="switchPet"
      >
        <face species="{{item.species}}" mood="calm" breed-id="{{item.breedId}}" size="sm" />
        <text>{{item.name}}</text>
      </view>
    </view>

    <view class="dateline">{{dateLine}}</view>
    <view class="headline serif">{{headline}}</view>
    <view class="headsub {{todos[0].status === 'over' ? 'warn' : ''}}">{{headlineSub}}</view>

    <!-- 待办 -->
    <view class="todo">
      <view class="td {{item.status}}" wx:for="{{todos}}" wx:key="key">
        <view class="ic">{{item.icon}}</view>
        <view class="tx">
          <view class="nm">{{item.name}}<text class="badge {{item.status}}">{{item.badge}}</text></view>
          <view class="dt">上次 {{item.last}} · {{item.months ? item.months + ' 个月一次' : ''}}</view>
        </view>
        <view class="bell {{item.bell ? 'on' : ''}}" data-key="{{item.key}}" catchtap="toggleBell">
          {{item.bell ? '🔔' : '🔕'}}
        </view>
        <view class="go" data-kind="{{item.kind}}" data-key="{{item.key}}" catchtap="openRecord">记一次</view>
      </view>
    </view>

    <!-- 随手记 -->
    <view class="sec-title" style="margin-top:36rpx"><text>随手记一笔</text><text class="link" bindtap="goRecords">全部记录 ›</text></view>
    <view class="quick">
      <view class="q" wx:for="{{quick}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="openRecord">
        <text class="qi">{{item.icon}}</text>
        <text class="qt">{{item.label}}</text>
      </view>
    </view>

    <!-- 最近 -->
    <view class="sec-title" style="margin-top:36rpx">
      <text>最近</text>
      <text class="dim">今年花了 ¥{{costYear}}</text>
    </view>
    <view wx:if="{{recent.length === 0}}" class="empty">还没有记录。点上面的「疫苗」或「驱虫」记第一次。</view>
    <view class="card" style="padding:6rpx 24rpx" wx:if="{{recent.length > 0}}">
      <view class="row" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="openOne">
        <text class="ric">{{item.icon}}</text>
        <view class="rt">
          <view class="rn">{{item.title}}</view>
          <view class="rd">{{item.date}} · {{item.ago}}{{item.sub ? ' · ' + item.sub : ''}}{{item.n ? ' · 附 ' + item.n : ''}}</view>
        </view>
        <text class="ra">›</text>
      </view>
    </view>

    <!-- 它写的 -->
    <view class="sec-title" style="margin-top:36rpx">
      <text>它写的</text>
      <text class="link" bindtap="goDiary">{{hasDiaryToday ? '看今天' : '写一篇'}} ›</text>
    </view>
    <view class="card diarycard" bindtap="goDiary">
      <face species="{{face.species}}" mood="calm" breed-id="{{face.breedId}}" size="sm" />
      <view class="dtx">
        <view class="dline">{{diaryLine || '今天还没写。记点事实，它会替你写一篇。'}}</view>
        <view class="sub" style="margin-top:6rpx">{{hasDiaryToday ? '它写的 · 今天' : '点一下去写'}}</view>
      </view>
    </view>
  </block>
</view>
