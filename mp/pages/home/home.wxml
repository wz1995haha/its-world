<!-- home.wxml — 该做什么 -->
<view class="app" style="{{themeStyle}}">

  <block wx:if="{{!hasPet || creating}}">
    <view class="card" style="margin-top:32rpx">
      <view class="h1 serif" style="margin-bottom:10rpx">{{hasPet ? '再添一只' : '先建一只'}}</view>
      <view class="sub" style="margin-bottom:28rpx">建好之后，疫苗、驱虫这些它会帮你记着日子。</view>

      <view class="field" style="margin-bottom:20rpx">
        <input placeholder="它叫什么" value="{{ob.name}}" bindinput="onName" maxlength="10" />
      </view>

      <view style="display:flex;gap:16rpx;margin-bottom:24rpx">
        <view class="btn {{ob.species === 'cat' ? 'primary' : ''}}" style="flex:1" data-sp="cat" bindtap="pickSpecies">猫</view>
        <view class="btn {{ob.species === 'dog' ? 'primary' : ''}}" style="flex:1" data-sp="dog" bindtap="pickSpecies">狗</view>
      </view>

      <view class="sec-title">品种 · 决定它长什么样</view>
      <picker mode="selector" range="{{breeds}}" range-key="label" value="{{ob.breedIndex}}" bindchange="onBreed">
        <view class="field">{{breeds[ob.breedIndex].label}}</view>
      </picker>

      <view class="btn primary" style="margin-top:36rpx" bindtap="create">{{hasPet ? '添上它' : '开始记录'}}</view>
      <view wx:if="{{hasPet}}" class="btn ghost" style="margin-top:16rpx" bindtap="cancelNew">算了</view>
    </view>
  </block>

  <block wx:else>
    <!-- 宠物切换 -->
    <view class="petsw">
      <view
        class="ps {{item.on ? 'on' : ''}}"
        wx:for="{{pets}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="switchPet"
      >
        <face species="{{item.species}}" mood="calm" breed-id="{{item.breedId}}" photo="{{item.photo}}" size="sm" />
        <text>{{item.name}}</text>
      </view>
      <view class="ps add" bindtap="newPet">＋</view>
    </view>

    <view class="dateline">{{dateLine}}</view>
    <view class="headline serif">{{headline}}</view>
    <view class="headsub {{todos[0].status === 'over' ? 'warn' : ''}}">{{headlineSub}}</view>

    <!-- 下次需要做 -->
    <view class="sec-title" style="margin-top:32rpx"><text>下次需要做</text><text class="dim">点铃铛可以开关提醒</text></view>
    <view class="todo">
      <view class="td {{item.status}}" wx:for="{{todos}}" wx:key="key">
        <view class="ic">{{item.icon}}</view>
        <view class="tx">
          <view class="nm">{{item.name}}<text class="badge {{item.status}}">{{item.badge}}</text></view>
          <view class="dt">下次 {{item.nextLine}}<text wx:if="{{item.last}}"> · 上次 {{item.last}}</text></view>
        </view>
        <view class="bell {{item.bell ? 'on' : ''}}" data-key="{{item.key}}" catchtap="toggleBell">
          {{item.bell ? '🔔' : '🔕'}}
        </view>
        <view class="go" data-kind="{{item.kind}}" data-key="{{item.key}}" catchtap="openRecord">记一次</view>
      </view>
      <view wx:if="{{todos.length === 0}}" class="empty" style="margin-top:8rpx">还没有要到期的事。去「记录」页记一次疫苗或驱虫，这里就会开始倒计时。</view>
    </view>

    <!-- 今年汇总 -->
    <view wx:if="{{sumYear.deworm || sumYear.vaccine || costYear}}" class="sumrow">
      <text class="sumlabel">这一年</text>
      <text class="sumitem" wx:if="{{sumYear.deworm}}">驱虫 {{sumYear.deworm}} 次</text>
      <text class="sumdot" wx:if="{{sumYear.deworm && sumYear.vaccine}}">·</text>
      <text class="sumitem" wx:if="{{sumYear.vaccine}}">疫苗 {{sumYear.vaccine}} 针</text>
      <text class="sumdot" wx:if="{{costYear && (sumYear.deworm || sumYear.vaccine)}}">·</text>
      <text class="sumitem" wx:if="{{costYear}}">花了 ¥{{costYear}}</text>
    </view>

    <!-- 最近 -->
    <view class="sec-title" style="margin-top:36rpx">
      <text>最近</text>
      <text class="link" bindtap="goRecords">全部 ›</text>
    </view>
    <view wx:if="{{recent.length === 0}}" class="empty">还没有记录。去「记录」页点「＋ 记一次」。</view>
    <view class="card" style="padding:6rpx 24rpx" wx:if="{{recent.length > 0}}">
      <view class="row" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="openOne">
        <text class="ric">{{item.icon}}</text>
        <view class="rt">
          <view class="rn">{{item.title}}</view>
          <view class="rd">{{item.date}} · {{item.ago}}{{item.sub ? ' · ' + item.sub : ''}}{{item.n ? ' · 附 ' + item.n : ''}}</view>
        </view>
        <text class="ra">›</text>
      </view>
    </view>

    <view class="sub" style="text-align:center;margin-top:30rpx">今年在它身上花了 ¥{{costYear}}</view>
  </block>
</view>
