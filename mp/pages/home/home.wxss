/* home.wxss — 该做什么 */
.petsw {
  display: flex;
  gap: 16rpx;
  margin-bottom: 26rpx;
  flex-wrap: wrap;
}
.ps {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx 10rpx 10rpx;
  border-radius: 999rpx;
  background: var(--paper-2, #FBF6EC);
  border: 1rpx solid var(--line, rgba(58, 50, 44, .12));
  font-size: 25rpx;
  color: var(--muted, #6E635A);
}
.ps.on {
  border-color: rgba(194, 97, 63, .45);
  color: var(--accent, #C2613F);
  background: rgba(194, 97, 63, .07);
}

.dateline {
  font-size: 24rpx;
  color: var(--muted, #8C8074);
  margin-bottom: 8rpx;
}
.headline {
  font-size: 52rpx;
  line-height: 1.25;
  letter-spacing: 1rpx;
  font-weight: 600;
}
.headsub {
  font-size: 25rpx;
  color: var(--muted, #8C8074);
  margin: 10rpx 0 30rpx;
}
.headsub.warn { color: #B24C3C; }

/* 待办卡 */
.todo { display: flex; flex-direction: column; gap: 18rpx; }
.td {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx;
  border-radius: 26rpx;
  background: var(--paper-2, #FBF6EC);
  border: 1rpx solid var(--line, rgba(58, 50, 44, .10));
  box-shadow: 0 20rpx 44rpx -40rpx rgba(var(--sh, 58, 50, 44), .9);
}
.td .ic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex: none;
  background: rgba(var(--sh, 58, 50, 44), .06);
}
.td .tx { flex: 1; min-width: 0; }
.td .nm { font-size: 29rpx; font-weight: 600; color: var(--ink, #3A322C); }
.td .dt { font-size: 22rpx; color: var(--muted, #8C8074); margin-top: 6rpx; }
.td .go {
  font-size: 23rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line, rgba(58, 50, 44, .16));
  color: var(--muted, #6E635A);
  flex: none;
}
.td .bell {
  font-size: 30rpx;
  opacity: .45;
  flex: none;
  padding: 6rpx;
}
.td .bell.on { opacity: 1; }

.td.over { border-color: rgba(178, 76, 60, .42); background: rgba(178, 76, 60, .06); }
.td.over .ic { background: rgba(178, 76, 60, .12); }
.td.over .go { border-color: rgba(178, 76, 60, .4); color: #B24C3C; }
.td.soon { border-color: rgba(194, 130, 63, .40); background: rgba(194, 130, 63, .055); }
.td.soon .ic { background: rgba(194, 130, 63, .13); }
.td.soon .go { border-color: rgba(194, 130, 63, .38); color: #A9762F; }

.badge { font-size: 20rpx; padding: 3rpx 12rpx; border-radius: 999rpx; margin-left: 12rpx; }
.badge.over { background: rgba(178, 76, 60, .14); color: #B24C3C; }
.badge.soon { background: rgba(194, 130, 63, .16); color: #A9762F; }
.badge.ok { background: rgba(var(--sh, 58, 50, 44), .07); color: var(--muted, #8C8074); }

/* 随手记 */
.quick { display: flex; gap: 16rpx; }
.q {
  flex: 1;
  text-align: center;
  padding: 22rpx 4rpx 18rpx;
  border-radius: 22rpx;
  border: 1rpx dashed var(--line, rgba(58, 50, 44, .2));
  background: rgba(251, 246, 236, .5);
}
.q .qi { font-size: 36rpx; display: block; }
.q .qt { font-size: 22rpx; color: var(--muted, #6E635A); margin-top: 8rpx; display: block; }

/* 最近 */
.row { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 0; border-top: 1rpx solid rgba(var(--sh, 58, 50, 44), .08); }
.row:first-child { border-top: 0; }
.ric { font-size: 30rpx; width: 44rpx; text-align: center; flex: none; }
.rt { flex: 1; min-width: 0; }
.rn { font-size: 27rpx; }
.rd { font-size: 22rpx; color: var(--muted, #8C8074); margin-top: 6rpx; }
.ra { font-size: 24rpx; color: var(--muted, #8C8074); flex: none; }

/* 它写的 */
.diarycard { display: flex; gap: 20rpx; align-items: center; padding: 24rpx; }
.dtx { flex: 1; min-width: 0; }
.dline {
  font-size: 26rpx;
  line-height: 1.6;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.empty {
  padding: 30rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx dashed var(--line, rgba(58, 50, 44, .2));
  color: var(--muted, #8C8074);
  font-size: 24rpx;
  text-align: center;
}

/* ---- 今年汇总 ---- */
.sumrow {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10rpx;
  margin: 8rpx 4rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(var(--sh, 58, 50, 44), .05);
}
.sumlabel {
  font-size: 21rpx;
  color: var(--muted, #9A8F84);
  margin-right: 6rpx;
}
.sumitem {
  font-size: 23rpx;
  color: var(--ink, #3A322C);
}
.sumdot {
  font-size: 21rpx;
  color: var(--muted, #9A8F84);
}
