<!-- today.wxml -->
<view class="app" style="{{themeStyle}}">

  <!-- 还没建宠物 -->
  <block wx:if="{{!hasPet}}">
    <view class="card" style="margin-top:60rpx">
      <view class="h1 serif" style="margin-bottom:12rpx">它眼里的世界</view>
      <view class="sub" style="margin-bottom:32rpx">你只记事实，它来写日记。\n日子久了，你就有它的一生。</view>

      <view class="field" style="margin-bottom:20rpx">
        <input placeholder="它叫什么" value="{{ob.name}}" bindinput="onName" maxlength="10" />
      </view>

      <view style="display:flex;gap:16rpx;margin-bottom:24rpx">
        <view class="btn {{ob.species === 'cat' ? 'primary' : ''}}" style="flex:1" data-sp="cat" bindtap="pickSpecies">🐱 猫</view>
        <view class="btn {{ob.species === 'dog' ? 'primary' : ''}}" style="flex:1" data-sp="dog" bindtap="pickSpecies">🐶 狗</view>
      </view>

      <view class="sec-title">品种 · 决定它长什么样</view>
      <picker mode="selector" range="{{breeds}}" range-key="label" value="{{ob.breedIndex}}" bindchange="onBreed">
        <view class="field">{{breeds[ob.breedIndex].label}}</view>
      </picker>

      <view class="sec-title">头像 · 上传它的照片，或者先用画的</view>
      <view class="obav">
        <face species="{{ob.species}}" mood="calm" breed-id="{{breeds[ob.breedIndex].id}}" photo="{{ob.photo}}" />
        <view class="obav-btns">
          <view class="btn sm" bindtap="pickPhoto">{{ob.photo ? '换一张' : '从相册选'}}</view>
          <view wx:if="{{ob.photo}}" class="btn sm ghost" catchtap="clearObPhoto">用画的</view>
        </view>
      </view>

      <view class="sec-title">性格 · 决定它写日记的语气</view>
      <picker mode="selector" range="{{persons}}" range-key="label" value="{{ob.personIndex}}" bindchange="onPerson">
        <view class="field">{{persons[ob.personIndex].label}}</view>
      </picker>

      <view class="btn primary" style="margin-top:36rpx" bindtap="start">开始记录</view>
    </view>
  </block>

  <!-- 有宠物 -->
  <block wx:else>
    <view class="sub" style="margin-bottom:8rpx">{{dayText}}</view>
    <view class="h1 serif" style="margin-bottom:26rpx">第 <text class="accent">{{dayNo}}</text> 天</view>

    <view class="card" style="display:flex;gap:20rpx;align-items:center">
      <face species="{{face.species}}" mood="{{face.mood}}" breed-id="{{face.breedId}}" photo="{{pet.photo}}" />
      <view style="flex:1">
        <view style="font-size:26rpx;line-height:1.6">{{greeting}}</view>
        <view class="sub" style="margin-top:8rpx">{{pet.name}} · {{eventCount > 0 ? '今天记了 ' + eventCount + ' 件事' : '今天还没有记录'}}</view>
      </view>
    </view>

    <view class="sec-title">
      <text>发生了什么</text>
      <text class="link" bindtap="toggleChipsEdit">{{chipsEdit ? '完成' : '编辑'}}</text>
    </view>

    <view class="chips">
      <view
        class="chip {{item.mine ? 'mine' : ''}} {{chipsEdit ? 'editing' : ''}}"
        wx:for="{{chipsShown}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="tapChip"
      >
        <text class="ci">{{item.icon}}</text>
        <text class="ct">{{item.label}}</text>
        <block wx:if="{{chipsEdit}}">
          <text class="cx" data-id="{{item.id}}" catchtap="hideChip">×</text>
          <text class="mv l" data-id="{{item.id}}" data-dir="-1" catchtap="moveChip">‹</text>
          <text class="mv r" data-id="{{item.id}}" data-dir="1" catchtap="moveChip">›</text>
        </block>
      </view>
    </view>

    <block wx:if="{{chipsEdit && chipsHidden.length}}">
      <view class="sec-title"><text>收起来了 · 点一下加回来</text></view>
      <view class="chips">
        <view class="chip" wx:for="{{chipsHidden}}" wx:key="id" data-id="{{item.id}}" bindtap="showChip">
          <text class="ci">{{item.icon}}</text>
          <text class="ct">{{item.label}}</text>
        </view>
      </view>
    </block>

    <view class="sec-title">
      <text>今天的事实</text>
      <text class="dim">{{eventCount}} 条</text>
    </view>
    <view wx:if="{{eventCount === 0}}" class="empty">今天还是空白。\n上面点几下就行，不用写句子。</view>
    <view wx:for="{{events}}" wx:key="id" class="ev">
      <text>{{item.icon}}</text>
      <text>{{item.label}}</text>
      <text class="n">{{item.extra}}</text>
      <text class="link" data-id="{{item.id}}" bindtap="delEvent" style="margin-left:16rpx">删</text>
    </view>

    <view class="field" style="margin-top:16rpx">
      <input placeholder="想补一句就写在这儿（选填）" value="{{note}}" bindinput="onNote" bindblur="saveNote" maxlength="60" />
    </view>

    <view class="btn primary" style="margin-top:28rpx" bindtap="write">
      {{hasDiary ? '重写今天的日记' : '让它写今天的日记'}}
    </view>
    <view class="sub" style="text-align:center;margin-top:18rpx">事实是给你看的，日记是它写的。同一个日子，两种记忆。</view>
  </block>

  <!-- 选项弹层 -->
  <block wx:if="{{sheet.open}}">
    <view class="sheet-mask" bindtap="closeSheet"></view>
    <view class="sheet">
      <view class="sheet-title">{{sheet.title}}</view>
      <view class="opt" wx:for="{{sheet.options}}" wx:key="*this" data-opt="{{item}}" bindtap="pickOption">
        <text>{{item}}</text>
        <text class="dim">›</text>
      </view>
    </view>
  </block>
</view>
