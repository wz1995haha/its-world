<!-- archive.wxml -->
<view class="app" style="{{themeStyle}}">
  <block wx:if="{{hasPet}}">
    <view class="head">
      <face species="{{face.species}}" mood="{{face.mood}}" breed-id="{{face.breedId}}" photo="{{pet.photo}}" />
      <view style="flex:1">
        <view class="h2 serif">{{pet.name}}</view>
        <view class="sub">{{breedLabel}}{{breedLabel ? ' · ' : ''}}{{personLabel}} · 陪伴 {{together}} 天</view>
      </view>
    </view>

    <view class="sec-title">
      <text>档案表</text>
      <text class="link" bindtap="{{editing ? 'editCancel' : 'editOpen'}}">{{editing ? '取消' : '编辑'}}</text>
    </view>

    <view class="card" wx:if="{{!editing}}">
      <view class="kv" wx:for="{{rows}}" wx:key="k">
        <text class="k">{{item.k}}</text>
        <text class="v">{{item.v}}</text>
      </view>
      <view class="addrow" bindtap="editOpen">＋ 加一项自己的</view>
    </view>

    <view class="card" wx:if="{{editing}}">
      <view class="kv edit">
        <text class="k">出生</text>
        <picker mode="date" value="{{edit.birth}}" bindchange="pickBirth">
          <view class="pk">{{edit.birth || '选择日期'}}</view>
        </picker>
      </view>
      <view class="kv edit">
        <text class="k">到家</text>
        <picker mode="date" value="{{edit.home}}" bindchange="pickHome">
          <view class="pk">{{edit.home || '选择日期'}}</view>
        </picker>
      </view>
      <view class="kv edit">
        <text class="k">品种</text>
        <picker mode="selector" range="{{breedLabels}}" value="{{edit.breedIndex}}" bindchange="pickBreed">
          <view class="pk">{{breedLabels[edit.breedIndex]}}</view>
        </picker>
      </view>
      <view class="kv edit">
        <text class="k">体重</text>
        <input class="inp" type="digit" value="{{edit.weight}}" data-k="weight" bindinput="onInput" placeholder="kg" />
      </view>

      <view class="kv edit fld" wx:for="{{edit.fields}}" wx:key="key">
        <input class="inp fl" value="{{item.label}}" data-idx="{{index}}" data-k="label" bindinput="onField" placeholder="名称" maxlength="12" />
        <input class="inp fv" value="{{item.value}}" data-idx="{{index}}" data-k="value" bindinput="onField" placeholder="内容" maxlength="60" />
        <text class="del" data-idx="{{index}}" bindtap="delField">×</text>
      </view>

      <view class="addrow" bindtap="addField">＋ 加一项</view>
      <view class="btnrow">
        <view class="btn primary" bindtap="editSave">保存</view>
        <view class="btn ghost" bindtap="editCancel">取消</view>
      </view>
      <view class="tip">体重改了会当成今天又称了一次。疫苗和驱虫是从「今天」里的记录数出来的。</view>
    </view>

    <view class="sec-title">
      <text>重要节点</text>
      <text class="link" bindtap="addNode">＋ 记一个</text>
    </view>

    <view class="card" wx:if="{{years.length}}">
      <block wx:for="{{years}}" wx:for-item="y" wx:key="title">
        <view class="yl">{{y.title}}</view>
        <view class="li" wx:for="{{y.items}}" wx:key="dateText" >
          <view class="ld">{{item.dateText}}</view>
          <view class="lic">{{item.icon}}</view>
          <view class="lt">{{item.label}}</view>
          <view class="la">{{item.age}}</view>
          <view class="lx" wx:if="{{item.mine}}" data-id="{{item.id}}" bindtap="delNode">×</view>
        </view>
      </block>
    </view>
    <view wx:else class="empty">还没有节点。\n日记里记的疫苗、看病、洗澡会自动出现在这里。</view>

    <view class="sec-title"><text>体重走势</text></view>
    <view class="card">
      <view wx:if="{{weight}}">
        <text class="wg serif">{{weight.kg}} kg</text>
        <text class="sub" style="margin-left:14rpx">{{weight.date}} 记的</text>
      </view>
      <view wx:else class="sub">还没记过体重。在上面的「称重」点一下。</view>
    </view>

    <view class="sub" style="text-align:center;margin-top:28rpx">它的一生，按日期排好</view>
  </block>
  <view wx:else class="empty" style="margin-top:60rpx">还没有宠物。</view>
</view>

