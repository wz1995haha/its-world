/* archive.wxss */
.head {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 8rpx;
}
.avhit { position: relative; flex: none; }
.avdot {
  position: absolute; right: -4rpx; bottom: -4rpx;
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: var(--paper-3, #FFFDF8); border: 1rpx solid var(--line, rgba(58, 50, 44, .12));
  color: var(--muted, #8C8074); font-size: 18rpx; line-height: 32rpx; text-align: center;
}
.kv {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-soft, rgba(58, 50, 44, .07));
  font-size: 26rpx;
}
.kv:last-child { border-bottom: 0; }
.kv .k { color: var(--muted, #8C8074); }
.kv .v { color: var(--ink, #3A322C); }
.yl {
  font-size: 24rpx;
  color: var(--muted, #8C8074);
  margin: 20rpx 0 10rpx;
}
.li {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line-soft, rgba(58, 50, 44, .06));
  font-size: 26rpx;
}
.ld { width: 128rpx; color: var(--ink-soft, #5C5148); flex: none; }
.lic { width: 36rpx; text-align: center; flex: none; }
.lt { flex: 1; color: var(--ink, #3A322C); }
.la { font-size: 22rpx; color: var(--muted, #8C8074); }
.lx {
  width: 40rpx; text-align: center;
  color: var(--muted, #8C8074); font-size: 28rpx;
}
.wg { font-size: 46rpx; color: var(--ink, #3A322C); }

/* ---- 档案表编辑态 ---- */
.kv.edit { align-items: center; gap: 16rpx; }
.kv.edit .k { flex: none; width: 110rpx; }
.kv.edit .pk,
.kv.edit .inp {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: var(--paper-2, #F6EFE2);
  border: 1rpx solid var(--line-soft, rgba(58, 50, 44, .1));
  font-size: 26rpx;
  color: var(--ink, #3A322C);
  text-align: right;
}
.kv.edit .pk { color: var(--ink, #3A322C); }
.kv.edit .inp { min-height: 64rpx; }
.kv.fld { flex-wrap: nowrap; }
.kv.fld .fl { flex: none; width: 34%; text-align: left; }
.kv.fld .fv { flex: 1; }
.del {
  flex: none;
  width: 44rpx;
  text-align: center;
  color: var(--muted, #8C8074);
  font-size: 30rpx;
}
.addrow {
  margin-top: 16rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--muted, #8C8074);
  border: 1rpx dashed var(--line-soft, rgba(58, 50, 44, .18));
  border-radius: 14rpx;
}
.btnrow { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btnrow .btn { flex: 1; }
.btnrow .ghost {
  background: transparent;
  color: var(--muted, #8C8074);
  border: 1rpx solid var(--line-soft, rgba(58, 50, 44, .18));
}
.tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--muted, #8C8074);
}
