/* story.wxss — 写一条成长记录 */
.stext {
  width: 100%;
  min-height: 220rpx;
  font-size: 29rpx;
  line-height: 1.7;
  color: var(--ink);
}

.tagrow {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.tg {
  font-size: 25rpx;
  color: var(--muted);
  background: var(--paper-2);
  border: 1rpx solid rgba(var(--sh), .10);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.tg.on {
  color: var(--accent);
  border-color: rgba(var(--accent-rgb), .40);
  background: rgba(var(--accent-rgb), .09);
}

.filebar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.fbtn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: var(--paper-2);
  border: 1rpx dashed rgba(var(--sh), .22);
  border-radius: 16rpx;
  padding: 14rpx 26rpx;
}

.fi {
  font-size: 26rpx;
}

.fstrip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.fitem {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: rgba(var(--sh), .06);
}

.fimg {
  width: 100%;
  height: 100%;
}

.fplay {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 46rpx;
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, .45);
  color: #fff;
  font-size: 22rpx;
}

.fdel {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, .5);
  color: #fff;
  font-size: 24rpx;
}

.delrow {
  text-align: center;
  margin-top: 28rpx;
}

.del {
  font-size: 26rpx;
  color: #B24C3C;
}
