.avrow { display: flex; justify-content: center; gap: 26rpx; margin-bottom: 12rpx; }
.avrow .dim { color: var(--muted, #8C8074); }
/* pet.wxss */
.st { flex: 1; text-align: center; }
.sn { font-size: 44rpx; color: var(--ink, #3A322C); }
.sl { font-size: 22rpx; color: var(--muted, #8C8074); margin-top: 4rpx; }
.kv {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-soft, rgba(58, 50, 44, .07));
  font-size: 26rpx;
}
.kv:last-child { border-bottom: 0; }
.kv .k { color: var(--muted, #8C8074); }
.kv .v { color: var(--ink, #3A322C); }
.seg { display: flex; gap: 10rpx; }
.sg {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line, rgba(58, 50, 44, .12));
  font-size: 24rpx;
  color: var(--muted, #8C8074);
}
.sg.on {
  border-color: var(--accent, #C2613F);
  color: var(--accent, #C2613F);
  background: var(--wash, #FDF1EA);
}
.themes { display: flex; flex-wrap: wrap; gap: 16rpx; }
.th {
  width: calc((100% - 16rpx) / 2);
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: var(--paper-2, #FBF6EC);
  border: 1rpx solid var(--line, rgba(58, 50, 44, .12));
}
.th.on { border-color: var(--accent, #C2613F); background: var(--wash, #FDF1EA); }
.thn { font-size: 28rpx; color: var(--ink, #3A322C); }
.thh { font-size: 20rpx; color: var(--muted, #8C8074); margin-top: 4rpx; }
.cr {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line-soft, rgba(58, 50, 44, .06));
  font-size: 26rpx;
}
.cl { flex: 1; }
.cm, .cx, .cd {
  font-size: 22rpx;
  color: var(--muted, #8C8074);
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line-soft, rgba(58, 50, 44, .1));
}
.cx { color: var(--accent, #C2613F); }
.addrow {
  padding: 22rpx 0 6rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--accent, #C2613F);
}
.yl { font-size: 22rpx; color: var(--muted, #8C8074); margin-top: 18rpx; }
.btns { display: flex; gap: 14rpx; flex-wrap: wrap; }
.avwrap { position: relative; display: inline-block; }
.avadd {
  position: absolute; right: 0; bottom: 6rpx; width: 54rpx; height: 54rpx;
  border-radius: 50%; background: var(--accent, #C2613F); color: #fff;
  font-size: 24rpx; line-height: 54rpx; text-align: center;
  border: 3rpx solid var(--paper, #F5EEE3);
}

/* 它的空间入口 */
.space {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--paper-2);
  border: 1rpx solid rgba(var(--accent-rgb), .28);
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  margin: 6rpx 0 26rpx;
}

.space-l { flex: 1; min-width: 0; }

.space-t {
  font-size: 32rpx;
  color: var(--ink);
  margin-bottom: 6rpx;
}

.space-s {
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.5;
}

.space-r {
  font-size: 24rpx;
  color: var(--accent);
  flex: none;
}
/* ---- 头像 + 陪伴天数 ---- */
.hero {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 12rpx 4rpx 8rpx;
}
.hero-main { flex: 1; min-width: 0; }
.hero-main .h1 { text-align: left; line-height: 1.2; }
.hero-main .sub { text-align: left; margin-top: 6rpx; }
.days {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 14rpx;
}
.dl { font-size: 22rpx; color: var(--muted, #8C8074); }
.dn {
  font-size: 44rpx;
  line-height: 1;
  color: var(--ink, #3A322C);
  letter-spacing: 1rpx;
}
.avrow { margin-top: 12rpx; display: flex; gap: 20rpx; }

/* ---- 它的空间（放大版） ---- */
.space {
  margin-top: 28rpx;
  padding: 26rpx 26rpx 20rpx;
  border-radius: 26rpx;
  background: var(--paper-2, #FBF6EC);
  border: 1rpx solid var(--line, rgba(58, 50, 44, .10));
}
.space-top { display: flex; align-items: baseline; justify-content: space-between; }
.space-t { font-size: 34rpx; }
.space-r { font-size: 22rpx; color: var(--accent, #C2613F); }
.space-s { margin-top: 10rpx; font-size: 22rpx; color: var(--muted, #9A8F84); line-height: 1.55; }

.sp-list { margin-top: 18rpx; border-top: 1rpx dashed var(--line, rgba(58, 50, 44, .12)); }
.sp-item {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--line, rgba(58, 50, 44, .10));
}
.sp-d { font-size: 21rpx; color: var(--muted, #9A8F84); flex: none; }
.sp-t {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--ink, #3A322C);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sp-empty { margin-top: 18rpx; font-size: 22rpx; color: var(--muted, #9A8F84); line-height: 1.6; }
.sp-more {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line, rgba(58, 50, 44, .12));
  font-size: 23rpx;
  color: var(--accent, #C2613F);
  text-align: center;
}

/* ---- 家里的几只 ---- */
.prow {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx dashed var(--line, rgba(58, 50, 44, .12));
}
.prow:first-child { border-top: 0; padding-top: 6rpx; }
.prow.on { background: rgba(var(--accent-rgb, 194, 97, 63), .06); margin: 0 -14rpx; padding-left: 14rpx; padding-right: 14rpx; border-radius: 16rpx; }
.pinfo { flex: 1; min-width: 0; }
.pname { font-size: 27rpx; color: var(--ink, #3A322C); }
.psub { margin-top: 4rpx; font-size: 21rpx; color: var(--muted, #9A8F84); }
.pon { font-size: 20rpx; color: var(--accent, #C2613F); flex: none; }
.prow.add {
  justify-content: center;
  color: var(--accent, #C2613F);
  font-size: 24rpx;
  border-top: 1rpx dashed var(--line, rgba(58, 50, 44, .12));
  padding: 22rpx 0;
}

/* 首页切换条里的「＋」 */
.ps.add {
  justify-content: center;
  padding: 0 22rpx;
  color: var(--accent, #C2613F);
  font-size: 30rpx;
  border-style: dashed;
}
