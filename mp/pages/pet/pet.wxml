<!-- pet.wxml -->
<view class="app" style="{{themeStyle}}">
  <block wx:if="{{hasPet}}">
    <!-- 头像 + 陪伴天数 -->
    <view class="hero">
      <view class="avwrap" bindtap="choosePhoto">
        <face species="{{face.species}}" mood="{{face.mood}}" breed-id="{{face.breedId}}" photo="{{pet.photo}}" size="lg" />
        <view class="avadd">📷</view>
      </view>
      <view class="hero-main">
        <view class="h1 serif">{{pet.name}}</view>
        <view class="sub">{{breedLabel}} · {{personLabel}}</view>
        <view class="days">
          <text class="dl">陪伴</text>
          <text class="dn serif">{{together}}</text>
          <text class="dl">天</text>
        </view>
        <view class="avrow">
          <text class="link" bindtap="choosePhoto">{{pet.photo ? '换一张照片' : '用它的照片'}}</text>
          <text wx:if="{{pet.photo}}" class="link dim" bindtap="clearPhoto">用回画的</text>
        </view>
      </view>
    </view>

    <!-- 家里的几只 -->
    <view class="sec-title"><text>家里的 {{petCount}} 只</text><text class="dim">点名字切换</text></view>
    <view class="card">
      <view class="prow {{item.on ? 'on' : ''}}" wx:for="{{pets}}" wx:key="id" data-id="{{item.id}}" bindtap="switchPet">
        <face species="{{item.species}}" mood="calm" breed-id="{{item.breedId}}" size="sm" />
        <view class="pinfo">
          <view class="pname">{{item.name}}</view>
          <view class="psub">{{item.sub}}</view>
        </view>
        <text wx:if="{{item.on}}" class="pon">现在看的是它</text>
      </view>
      <view class="prow add" bindtap="newPet">＋ 再添一只</view>
    </view>

    <!-- 它的空间 -->
    <view class="space" bindtap="goSpace">
      <view class="space-top">
        <view class="space-t serif">它的空间</view>
        <view class="space-r">{{storyCount}} 条 ›</view>
      </view>
      <view class="space-s">从到家的第一天开始，照片、视频、第一次，都留在这儿</view>

      <view wx:if="{{spaceRecent.length}}" class="sp-list">
        <view class="sp-item" wx:for="{{spaceRecent}}" wx:key="id">
          <text class="sp-d">{{item.date}}</text>
          <text class="sp-t">{{item.title}}</text>
        </view>
      </view>
      <view wx:else class="sp-empty">还没有记录。第一次回家、第一次洗澡、第一次学会坐下——都值得留一条。</view>

      <view class="sp-more" catchtap="goSpace">进去看看 / 记一条 ›</view>
    </view>

    <view class="sec-title"><text>资料</text><text class="link" bindtap="rename">改名</text></view>
    <view class="card">
      <view class="kv">
        <text class="k">它是</text>
        <view class="seg">
          <text class="sg {{pet.species === 'cat' ? 'on' : ''}}" data-sp="cat" bindtap="onSpecies">猫</text>
          <text class="sg {{pet.species === 'dog' ? 'on' : ''}}" data-sp="dog" bindtap="onSpecies">狗</text>
        </view>
      </view>
      <picker mode="selector" range="{{breeds}}" range-key="label" value="{{ob.breedIndex}}" bindchange="onBreed">
        <view class="kv"><text class="k">品种</text><text class="v">{{breedLabel}} ›</text></view>
      </picker>
      <picker mode="selector" range="{{['傲娇','黏人','高冷','贪吃','好奇']}}" value="{{ob.personIndex}}" bindchange="onPerson">
        <view class="kv"><text class="k">性格</text><text class="v">{{personLabel}} ›</text></view>
      </picker>
      <picker mode="date" value="{{pet.birthday}}" start="1900-01-01" end="2099-12-31" bindchange="onBirthday">
        <view class="kv">
          <text class="k">生日</text>
          <text class="v">{{pet.birthday || '选日期'}} ›</text>
        </view>
      </picker>
      <picker mode="date" value="{{pet.homeDate}}" start="1900-01-01" end="2099-12-31" bindchange="onHomeDate">
        <view class="kv">
          <text class="k">到家</text>
          <text class="v">{{pet.homeDate || '选日期'}} ›</text>
        </view>
      </picker>
    </view>

    <view class="sec-title"><text>切换主题</text><text class="dim">只换样子，不影响内容</text></view>
    <view class="themes">
      <view class="th {{item.on ? 'on' : ''}}" wx:for="{{themes}}" wx:key="id" data-id="{{item.id}}" bindtap="setTheme">
        <view class="thn">{{item.label}}</view>
        <view class="thh">{{item.hint}}</view>
      </view>
    </view>

    <view class="sec-title"><text>数据</text><text class="dim">{{cloudOn ? '已接云端' : '只在本机'}}</text></view>
    <view class="card">
      <view class="btns">
        <view class="btn sm" bindtap="copyBackup">导出备份</view>
        <view class="btn sm" bindtap="demo">载入示例</view>
        <view class="btn sm" bindtap="resetAll">重新开始</view>
      </view>
      <view class="sub" style="margin-top:16rpx">{{cloudOn ? '记录会同步到你的微信账号，换手机登同一个微信自动回来。' : '数据只存在这台设备的微信里。换手机前记得导出备份。'}}</view>
    </view>

    <view class="sub" style="text-align:center;margin-top:30rpx">「爪记一生」· 疫苗、驱虫、看病、体重，一页记一辈子</view>
  </block>

  <block wx:else>
    <view class="empty" style="margin-top:80rpx">还没有宠物。先去「该做」页建一只。</view>
    <view class="btn primary" style="margin-top:24rpx" bindtap="goCreate">去建一只</view>
    <view class="btn" style="margin-top:16rpx" bindtap="demo">先看看示例</view>
  </block>
</view>
