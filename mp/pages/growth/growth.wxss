/* growth.wxss — 它的空间 */
.ghead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.gface {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex: none;
}

.gmeta {
  flex: 1;
  min-width: 0;
}

.gname {
  font-size: 40rpx;
  color: var(--ink);
}

.gsub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.gyear {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
  margin: 28rpx 0 12rpx 34rpx;
}

.gitem {
  position: relative;
  display: flex;
  padding-left: 34rpx;
}

/* 时间线：一条竖线 + 圆点 */
.gitem::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: rgba(var(--sh), .14);
}

.gdot {
  position: absolute;
  left: 7rpx;
  top: 34rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
}

.gcard {
  flex: 1;
  min-width: 0;
  background: var(--paper-2);
  border-radius: 20rpx;
  border: 1rpx solid rgba(var(--sh), .08);
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.gtop {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.gdate {
  font-size: 23rpx;
  color: var(--muted);
}

.gtag {
  font-size: 21rpx;
  color: var(--accent);
  background: rgba(var(--accent-rgb), .09);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.gage {
  font-size: 21rpx;
  color: var(--muted);
  margin-left: auto;
}

.gtitle {
  font-size: 32rpx;
  color: var(--ink);
  margin: 4rpx 0 6rpx;
}

.gtext {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--ink);
  opacity: .86;
  white-space: pre-wrap;
}

.gtext.clamp {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.gshots {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.gshot {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: rgba(var(--sh), .06);
}

.gimg {
  width: 100%;
  height: 100%;
  display: block;
}

.gmore {
  align-self: center;
  font-size: 24rpx;
  color: var(--muted);
  padding-left: 6rpx;
}

.gvideo {
  position: relative;
  margin-top: 14rpx;
  width: 320rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #000;
}

.gplay {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, .45);
  color: #fff;
  font-size: 28rpx;
}

.gdur {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  color: #fff;
  opacity: .9;
}

.gadd {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: 29rpx;
  box-shadow: 0 8rpx 24rpx rgba(var(--sh), .18);
}
